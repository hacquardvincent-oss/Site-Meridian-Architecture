---
/**
 * Composition géométrique déstructurée (100 % vectorielle).
 * Variantes : 'fragments' (formes éclatées) · 'arc' (arcs concentriques) · 'plan' (plan d'architecte).
 * Lignes en currentColor (encre), accents et tracés animés en bleu pastel.
 */
interface Props { variant?: 'fragments' | 'arc' | 'plan'; class?: string }
const { variant = 'fragments', class: className = '' } = Astro.props;
const A = '#9db8dd';
---
<div class:list={['geo', `geo--${variant}`, className]}>
  <svg viewBox="0 0 400 480" role="img" aria-label="Composition géométrique" fill="none">
    <line x1="200" y1="24" x2="200" y2="456" stroke="currentColor" stroke-width="1" opacity="0.12" />

    {variant === 'fragments' && (
      <g>
        <rect x="96" y="120" width="208" height="208" stroke="currentColor" stroke-width="1.3" transform="rotate(-7 200 224)" />
        <rect x="150" y="174" width="100" height="100" stroke="currentColor" stroke-width="1.3" transform="rotate(8 200 224)" opacity="0.55" />
        <path d="M300 60 L340 80 L300 100 L260 80 Z" stroke="currentColor" stroke-width="1.2" opacity="0.5" />
        <path class="geo__draw" d="M70 360 A90 90 0 0 1 250 360" stroke={A} stroke-width="1.6" />
        <line x1="60" y1="110" x2="120" y2="110" stroke="currentColor" stroke-width="1.2" opacity="0.4" />
        <line x1="60" y1="110" x2="60" y2="160" stroke="currentColor" stroke-width="1.2" opacity="0.4" />
        <circle cx="160" cy="360" r="3.4" fill={A} />
        <circle cx="200" cy="224" r="3.4" fill={A} />
      </g>
    )}

    {variant === 'arc' && (
      <g>
        <circle cx="200" cy="240" r="150" stroke="currentColor" stroke-width="1.2" opacity="0.4" />
        <circle cx="200" cy="240" r="96" stroke="currentColor" stroke-width="1.2" opacity="0.25" />
        <path class="geo__draw" d="M200 90 A150 150 0 0 1 350 240" stroke={A} stroke-width="1.8" />
        <line x1="50" y1="240" x2="350" y2="240" stroke="currentColor" stroke-width="1" opacity="0.2" />
        <path d="M70 70 L110 70 M70 70 L70 110" stroke="currentColor" stroke-width="1.2" opacity="0.45" />
        <circle cx="200" cy="240" r="3.6" fill={A} />
        <circle cx="350" cy="240" r="3.6" fill={A} />
      </g>
    )}

    {variant === 'plan' && (
      <g stroke="currentColor">
        <rect x="80" y="120" width="240" height="240" stroke-width="1.3" />
        <line x1="200" y1="120" x2="200" y2="360" stroke-width="1" opacity="0.5" />
        <line x1="80" y1="240" x2="320" y2="240" stroke-width="1" opacity="0.5" />
        <path class="geo__draw" d="M200 240 A60 60 0 0 1 260 300" stroke={A} stroke-width="1.6" fill="none" />
        <rect x="120" y="160" width="40" height="40" stroke-width="1" opacity="0.4" />
        <path d="M60 100 L60 92 M60 100 L52 100" stroke-width="1.2" opacity="0.5" />
        <circle cx="200" cy="240" r="3.4" fill={A} stroke="none" />
      </g>
    )}
  </svg>
</div>

<style>
  .geo { color: var(--ink); width: 100%; display: grid; place-items: center; }
  .geo svg { width: 100%; height: auto; overflow: visible; }
  .geo__draw { stroke-dasharray: 480; stroke-dashoffset: 480; animation: geodraw 2s var(--ease) 0.3s forwards; }
  @keyframes geodraw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .geo__draw { stroke-dashoffset: 0; animation: none; } }
</style>
