---
/**
 * Structure isométrique filaire — « l'édifice » Meridian.
 * Trois plateaux empilés et décalés (déstructuré), reliés par une colonne
 * (l'interconnexion) en bleu pastel. 100 % vectoriel, animé au tracé.
 */
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<div class:list={['iso', className]}>
  <svg viewBox="0 0 420 520" role="img" aria-label={'Structure isométrique : trois plateaux reliés, métaphore de l’écosystème'}>
    <!-- axe + fragments déstructurés -->
    <line x1="210" y1="36" x2="210" y2="492" stroke="currentColor" stroke-width="1" opacity="0.12" />
    <path d="M360 72 L392 88 L360 104 L328 88 Z" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35" />
    <path d="M40 150 H96 M40 150 V198" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3" />

    <!-- Plateau A -->
    <g class="iso__plate" stroke="currentColor" stroke-width="1.3" fill="none">
      <path d="M210 82 L305 130 L210 178 L115 130 Z" />
      <path d="M115 130 L210 178 L210 194 L115 146 Z" />
      <path d="M210 178 L305 130 L305 146 L210 194 Z" />
    </g>
    <!-- Plateau B (décalé) -->
    <g class="iso__plate" stroke="currentColor" stroke-width="1.3" fill="none">
      <path d="M185 217 L280 265 L185 313 L90 265 Z" />
      <path d="M90 265 L185 313 L185 329 L90 281 Z" />
      <path d="M185 313 L280 265 L280 281 L185 329 Z" />
    </g>
    <!-- Plateau C (décalé) -->
    <g class="iso__plate" stroke="currentColor" stroke-width="1.3" fill="none">
      <path d="M235 352 L330 400 L235 448 L140 400 Z" />
      <path d="M140 400 L235 448 L235 464 L140 416 Z" />
      <path d="M235 448 L330 400 L330 416 L235 464 Z" />
    </g>

    <!-- Colonne d'interconnexion (bleu pastel, tracé animé) -->
    <path class="iso__spine" d="M210 178 L185 217 M185 313 L235 352" stroke="#9db8dd" stroke-width="1.6" fill="none" />
    <g class="iso__nodes" fill="#9db8dd">
      <circle cx="210" cy="178" r="3.2" />
      <circle cx="185" cy="217" r="3.2" />
      <circle cx="185" cy="313" r="3.2" />
      <circle cx="235" cy="352" r="3.2" />
    </g>
  </svg>
</div>

<style>
  .iso { color: var(--ink); width: 100%; display: grid; place-items: center; padding: var(--space-l); }
  .iso svg { width: 100%; max-width: 26rem; height: auto; overflow: visible; }
  .iso__spine { stroke-dasharray: 180; stroke-dashoffset: 180; animation: isodraw 1.8s var(--ease) 0.3s forwards; }
  .iso__nodes circle { opacity: 0; animation: isofade 0.5s ease forwards; }
  .iso__nodes circle:nth-child(1) { animation-delay: 0.6s; }
  .iso__nodes circle:nth-child(2) { animation-delay: 0.9s; }
  .iso__nodes circle:nth-child(3) { animation-delay: 1.2s; }
  .iso__nodes circle:nth-child(4) { animation-delay: 1.5s; }
  @keyframes isodraw { to { stroke-dashoffset: 0; } }
  @keyframes isofade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .iso__spine { stroke-dashoffset: 0; animation: none; }
    .iso__nodes circle { opacity: 1; animation: none; }
  }
</style>
