---
/** Glyphe géométrique line-art par domaine (BI · ERP · PLM · PIM · WEB). */
interface Props { abbr: string; class?: string }
const { abbr, class: className = '' } = Astro.props;

const glyphs: Record<string, string> = {
  // Business Intelligence — barres ascendantes
  BI: 'M5 27 H27 M9 27 V19 M16 27 V13 M23 27 V8 M23 8 L20.5 11 M23 8 L25.5 11',
  // Gestion intégrée — grille 2×2
  ERP: 'M6 6 H26 V26 H6 Z M16 6 V26 M6 16 H26',
  // Cycle de vie produit — losanges imbriqués (versions)
  PLM: 'M16 4 L28 16 L16 28 L4 16 Z M16 10 L22 16 L16 22 L10 16 Z',
  // Information produit — plateaux empilés (source unique)
  PIM: 'M16 5 L27 10.5 L16 16 L5 10.5 Z M5 16 L16 21.5 L27 16 M5 21.5 L16 27 L27 21.5',
  // Sites & portails — cadre / fenêtre
  WEB: 'M5 7 H27 V25 H5 Z M5 12 H27 M12 12 V25',
};
const d = glyphs[abbr] ?? glyphs.ERP;
---
<svg class:list={['glyph', className]} viewBox="0 0 32 32" role="img" aria-label={abbr} fill="none">
  <path d={d} stroke="currentColor" stroke-width="1.4" stroke-linecap="square" stroke-linejoin="miter" />
</svg>

<style>
  .glyph { width: 2.25rem; height: 2.25rem; display: block; color: var(--ink); transition: color var(--dur) var(--ease); }
</style>
