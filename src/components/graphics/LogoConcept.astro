---
/** Concepts de logo (marks) — variations géométriques autour du « méridien ». */
interface Props { concept: string; class?: string }
const { concept, class: className = '' } = Astro.props;
const A = '#9db8dd';
---
<svg class:list={['lc', className]} viewBox="0 0 48 48" fill="none" role="img" aria-label={`Concept ${concept}`}>
  {concept === 'a' && (
    <g>
      <g stroke="currentColor" stroke-width="1.7">
        <circle cx="24" cy="24" r="11" />
        <line x1="24" y1="6" x2="24" y2="42" />
        <line x1="17" y1="6" x2="31" y2="6" />
        <line x1="17" y1="42" x2="31" y2="42" />
      </g>
      <circle cx="24" cy="24" r="2.6" fill={A} />
    </g>
  )}
  {concept === 'b' && (
    <g>
      <path d="M12 39 V11 L24 27 L36 11 V39" stroke="currentColor" stroke-width="1.7" stroke-linejoin="miter" />
      <circle cx="24" cy="27" r="2.6" fill={A} />
    </g>
  )}
  {concept === 'c' && (
    <g>
      <g stroke="currentColor" stroke-width="1.7">
        <rect x="12" y="12" width="24" height="24" />
        <line x1="24" y1="6" x2="24" y2="42" />
      </g>
      <circle cx="24" cy="24" r="2.6" fill={A} />
    </g>
  )}
  {concept === 'd' && (
    <g>
      <g stroke="currentColor" stroke-width="1.7">
        <circle cx="24" cy="24" r="14" />
        <line x1="24" y1="6" x2="24" y2="42" />
        <line x1="6" y1="24" x2="42" y2="24" />
      </g>
      <circle cx="24" cy="24" r="2.6" fill={A} />
    </g>
  )}
  {concept === 'e' && (
    <g>
      <g stroke="currentColor" stroke-width="1.7">
        <line x1="24" y1="8" x2="24" y2="40" />
        <line x1="14" y1="15" x2="34" y2="15" />
        <line x1="16" y1="24" x2="36" y2="24" />
        <line x1="12" y1="33" x2="32" y2="33" />
      </g>
      <circle cx="24" cy="24" r="2.6" fill={A} />
    </g>
  )}
  {concept === 'f' && (
    <g>
      <g stroke="currentColor" stroke-width="1.7" fill="none">
        <line x1="24" y1="6" x2="24" y2="42" />
        <path d="M24 10 A14 14 0 0 1 38 24" />
        <line x1="10" y1="38" x2="15" y2="38" />
      </g>
      <circle cx="24" cy="24" r="2.6" fill={A} />
    </g>
  )}
</svg>

<style>
  .lc { width: 3.5rem; height: 3.5rem; color: var(--ink); }
</style>
