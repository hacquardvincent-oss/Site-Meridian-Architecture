---
/**
 * Logo Meridian Architecture — mark géométrique moderne.
 * Un axe (méridien) + un anneau + des ticks de coordonnées ; point central bleu pastel.
 */
interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
---

<span class:list={['logo', `logo--${variant}`, className]}>
  <svg class="logo__mark" viewBox="0 0 32 32" role="img" aria-label="Meridian Architecture">
    <line x1="16" y1="2.5" x2="16" y2="29.5" stroke="currentColor" stroke-width="1.4" />
    <line x1="10.5" y1="2.5" x2="21.5" y2="2.5" stroke="currentColor" stroke-width="1.4" />
    <line x1="10.5" y1="29.5" x2="21.5" y2="29.5" stroke="currentColor" stroke-width="1.4" />
    <circle cx="16" cy="16" r="6.6" fill="none" stroke="currentColor" stroke-width="1.4" />
    <circle cx="16" cy="16" r="1.9" fill="#9db8dd" />
  </svg>
  {variant === 'full' && (
    <span class="logo__word">
      <span class="logo__name">Meridian</span>
      <span class="logo__sub">Architecture</span>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.65rem; color: currentColor; line-height: 1; }
  .logo__mark { width: 1.85rem; height: 1.85rem; flex: none; overflow: visible; }
  .logo__word { display: flex; flex-direction: column; gap: 0.2rem; }
  .logo__name { font-family: var(--font-display); font-size: 1.05rem; font-weight: 500; letter-spacing: -0.01em; }
  .logo__sub {
    font-family: var(--font-sans); font-size: 0.56rem; font-weight: 600;
    letter-spacing: 0.26em; text-transform: uppercase; color: var(--text-subtle);
  }
  :global(.section--ink) .logo__sub { color: color-mix(in srgb, currentColor 60%, transparent); }
</style>
