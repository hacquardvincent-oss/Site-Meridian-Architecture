---
/**
 * Logo Meridian Architecture.
 * Le mark associe le « méridien » (globe + ligne de longitude + arc)
 * à la rigueur d'un tracé d'architecte. Monochrome (currentColor).
 */
interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
---

<span class:list={['logo', `logo--${variant}`, className]} aria-hidden="false">
  <svg class="logo__mark" viewBox="0 0 32 32" role="img" aria-label="Meridian Architecture">
    <circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="1.2" />
    <ellipse cx="16" cy="16" rx="5.6" ry="13" fill="none" stroke="currentColor" stroke-width="1.2" />
    <line x1="16" y1="2.4" x2="16" y2="29.6" stroke="currentColor" stroke-width="1.2" />
    <line x1="3" y1="16" x2="29" y2="16" stroke="currentColor" stroke-width="0.9" opacity="0.45" />
  </svg>
  {variant === 'full' && (
    <span class="logo__word">
      <span class="logo__name">Meridian</span>
      <span class="logo__sub">Architecture</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: currentColor;
    line-height: 1;
  }
  .logo__mark {
    width: 2rem;
    height: 2rem;
    flex: none;
    overflow: visible;
  }
  .logo__word {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
  }
  .logo__name {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .logo__sub {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  /* Sur fond sombre, le sous-titre reste lisible */
  :global(.section--ink) .logo__sub,
  :global(.is-dark) .logo__sub {
    color: color-mix(in srgb, currentColor 65%, transparent);
  }
</style>
