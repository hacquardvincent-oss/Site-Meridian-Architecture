---
import GeoComposition from './graphics/GeoComposition.astro';
import IsoStructure from './graphics/IsoStructure.astro';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  index?: string;
  graphic?: 'fragments' | 'arc' | 'plan' | 'iso';
}
const { eyebrow, title, lead, index, graphic } = Astro.props;
---
<section class="page-hero">
  <div class="container page-hero__grid">
    <div class="page-hero__inner">
      <span class="eyebrow" data-reveal>{eyebrow}</span>
      <h1 class="page-hero__title" data-reveal style="--reveal-delay:80ms">{title}</h1>
      <p class="page-hero__lead lead" data-reveal style="--reveal-delay:160ms">{lead}</p>
    </div>
    {graphic && (
      <div class="page-hero__illus" data-reveal style="--reveal-delay:120ms">
        {graphic === 'iso' ? <IsoStructure /> : <GeoComposition variant={graphic} />}
      </div>
    )}
    {index && <span class="page-hero__index" aria-hidden="true">{index}</span>}
  </div>
  <div class="container"><hr class="rule page-hero__rule" data-reveal /></div>
</section>

<style>
  .page-hero { padding-block: clamp(3rem, 9vh, 6rem) 0; position: relative; overflow: hidden; }
  .page-hero__grid { position: relative; display: grid; gap: var(--space-xl); align-items: center; }
  .page-hero__inner { max-width: 46rem; display: flex; flex-direction: column; gap: var(--space-m); }
  .page-hero__title { font-size: var(--step-5); font-weight: 400; margin-top: 0.2rem; }
  .page-hero__lead { margin-top: var(--space-xs); }
  .page-hero__index {
    position: absolute; top: 0; right: 0; font-size: var(--step--1); color: var(--text-subtle);
    letter-spacing: var(--tracking-label);
  }
  .page-hero__illus { display: none; }
  .page-hero__rule { margin-top: var(--space-2xl); }
  @media (min-width: 60em) {
    .page-hero__grid { grid-template-columns: 1fr auto; }
    .page-hero__illus { display: block; width: min(18rem, 26vw); justify-self: end; }
  }
</style>
