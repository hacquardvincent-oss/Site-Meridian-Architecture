---
import { getContent } from '../../i18n/content';
import type { Locale } from '../../i18n/routes';
import PageHero from '../PageHero.astro';
import CtaPanel from '../CtaPanel.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale).solutions;
---
<PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.lead} index="02 — 05" />

<section class="section">
  <div class="container">
    <ul class="modules">
      {c.detail.map((m, i) => (
        <li class="module" data-reveal style={`--reveal-delay:${i * 50}ms`}>
          <div class="module__id">
            <span class="module__abbr mono">{m.abbr}</span>
            <span class="module__no mono">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="module__body">
            <h2 class="module__name">{m.name}</h2>
            <p class="module__lead lead">{m.text}</p>
            <p class="module__more muted">{m.more}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section section--alt">
  <div class="container interconnect" data-reveal>
    <div class="interconnect__head">
      <span class="eyebrow">{c.interconnect.eyebrow}</span>
      <h2 class="interconnect__title">{c.interconnect.title}</h2>
    </div>
    <p class="interconnect__text lead">{c.interconnect.text}</p>
  </div>
</section>

<CtaPanel locale={locale} />

<style>
  .modules { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; }
  .module {
    display: grid; gap: var(--space-m);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--line);
  }
  .module:last-child { border-bottom: 1px solid var(--line); }
  .module__id { display: flex; align-items: baseline; justify-content: space-between; }
  .module__abbr { font-family: var(--font-display); font-size: var(--step-3); font-weight: 500; color: var(--ink); letter-spacing: 0.01em; }
  .module__no { color: var(--text-subtle); font-size: var(--step--1); }
  .module__name { font-size: var(--step-2); }
  .module__lead { margin-top: var(--space-xs); max-width: none; }
  .module__more { margin-top: var(--space-s); max-width: 62ch; }
  @media (min-width: 56em) {
    .module { grid-template-columns: 0.32fr 0.68fr; gap: var(--space-2xl); align-items: start; }
    .module__id { flex-direction: column; gap: var(--space-s); }
  }

  .interconnect { display: grid; gap: var(--space-l); }
  .interconnect__title { margin-top: var(--space-s); }
  .interconnect__text { max-width: 52ch; }
  @media (min-width: 56em) { .interconnect { grid-template-columns: 0.9fr 1.1fr; gap: var(--space-2xl); align-items: start; } }
</style>
