---
import { getContent } from '../../i18n/content';
import type { Locale } from '../../i18n/routes';
import PageHero from '../PageHero.astro';
import CtaPanel from '../CtaPanel.astro';
import ModuleGlyph from '../graphics/ModuleGlyph.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const data = getContent(locale);
const c = data.solutions;
const modules = data.modules;
---
<PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.lead} index="01 — 05" image="/images/solutions.jpg" theme="light" />

<!-- Comment lire : la forme, posée sur l'ampleur -->
<section class="section">
  <div class="container axes" data-reveal>
    <span class="eyebrow">{c.axes.eyebrow}</span>
    <h2 class="axes__title">{c.axes.title}</h2>
    <p class="lead axes__body measure">{c.axes.body}</p>
  </div>
</section>

<!-- Les piliers : une section par forme, rangée par ampleur -->
<section class="section section--alt">
  <div class="container">
    <ol class="pillars">
      {c.pillars.map((p, i) => (
        <li class="pillar" id={p.slug} data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <div class="pillar__head">
            <span class="pillar__n mono">{String(i + 1).padStart(2, '0')}</span>
            <div class="pillar__id">
              <h3 class="pillar__name">{p.name}</h3>
              <p class="pillar__gloss">{p.gloss}</p>
            </div>
            <span class="pillar__marche mono"><span class="pillar__marche-label">{c.laddernote}</span>{p.marche}</span>
          </div>
          <p class="pillar__what measure">{p.what}</p>
          <p class="pillar__example">{p.example}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Le 5e pilier, en constellation : l'écosystème émerge -->
<section class="section">
  <div class="container endgame" data-reveal>
    <div class="endgame__head">
      <span class="eyebrow">{c.endgame.eyebrow}</span>
      <h2 class="endgame__title">{c.endgame.title}</h2>
      <p class="lead endgame__text">{c.endgame.text}</p>
    </div>
    <ul class="mods">
      {modules.map((m, i) => (
        <li class="mod" data-reveal style={`--reveal-delay:${i * 50}ms`}>
          <ModuleGlyph abbr={m.abbr} class="mod__glyph" />
          <span class="mod__abbr">{m.abbr}</span>
          <span class="mod__name">{m.name}</span>
        </li>
      ))}
    </ul>
    <div class="interconnect">
      <div class="interconnect__head">
        <span class="eyebrow">{c.interconnect.eyebrow}</span>
        <h3 class="interconnect__title">{c.interconnect.title}</h3>
      </div>
      <p class="interconnect__text lead">{c.interconnect.text}</p>
    </div>
  </div>
</section>

<CtaPanel locale={locale} />

<style>
  /* Comment lire */
  .axes { display: grid; gap: var(--space-s); max-width: 62ch; }
  .axes__title { margin-top: var(--space-2xs); font-size: var(--step-3); }
  .axes__body { margin-top: var(--space-2xs); }

  /* Les piliers — l'escalier des formes */
  .pillars { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2xl); }
  .pillar { padding-top: var(--space-l); border-top: 1px solid var(--line-strong); }
  .pillar__head { display: grid; grid-template-columns: auto 1fr; gap: var(--space-2xs) var(--space-m); align-items: baseline; }
  .pillar__n { grid-row: span 2; font-size: var(--step-0); color: var(--ink); letter-spacing: var(--tracking-wide); padding-top: 0.35em; }
  .pillar__id { display: flex; flex-direction: column; gap: var(--space-3xs); }
  .pillar__name { font-size: var(--step-3); font-weight: 400; letter-spacing: var(--tracking-tight); line-height: 1.05; }
  .pillar__gloss { font-size: var(--step-0); color: var(--text); }
  .pillar__marche {
    grid-column: 1 / -1; margin-top: var(--space-2xs);
    display: inline-flex; flex-wrap: wrap; gap: 0.5rem;
    font-size: var(--step--1); color: var(--text); letter-spacing: var(--tracking-wide);
  }
  .pillar__marche-label { color: var(--text-subtle); text-transform: uppercase; letter-spacing: var(--tracking-label); }
  .pillar__marche-label::after { content: '·'; margin-left: 0.5rem; color: var(--text-subtle); }
  .pillar__what { margin-top: var(--space-m); font-size: var(--step-1); color: var(--ink); line-height: var(--leading-normal); }
  .pillar__example {
    margin-top: var(--space-m); font-size: var(--step--1); line-height: var(--leading-normal); max-width: 60ch;
    padding: var(--space-s) var(--space-m); border-left: 2px solid var(--brass); background: var(--brass-wash); color: var(--text);
  }
  @media (min-width: 52em) {
    .pillar__head { grid-template-columns: auto 1fr auto; }
    .pillar__n { grid-row: 1; }
    .pillar__marche { grid-column: 3; grid-row: 1; margin-top: 0; justify-content: flex-end; text-align: right; align-self: baseline; }
    .pillar__what { max-width: 68ch; padding-left: calc(var(--step-0) + var(--space-m)); }
    .pillar__example { margin-left: calc(var(--step-0) + var(--space-m)); }
  }

  /* Écosystème — constellation */
  .endgame { display: grid; gap: var(--space-xl); }
  .endgame__head { display: grid; gap: var(--space-s); max-width: 60ch; }
  .endgame__title { margin-top: var(--space-2xs); }
  .endgame__text { max-width: 56ch; }
  .mods { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-m); }
  @media (min-width: 44em) { .mods { grid-template-columns: repeat(5, 1fr); } }
  .mod { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2xs); padding-top: var(--space-m); border-top: 1px solid var(--line); }
  .mod__glyph { width: 2.25rem; height: 2.25rem; color: var(--ink); }
  .mod__abbr { font-family: var(--font-display); font-size: var(--step-1); font-weight: 500; color: var(--ink); margin-top: var(--space-2xs); }
  .mod__name { font-size: var(--step--1); color: var(--text); }

  .interconnect { display: grid; gap: var(--space-l); padding-top: var(--space-l); border-top: 1px solid var(--line); }
  .interconnect__title { margin-top: var(--space-s); font-size: var(--step-2); }
  .interconnect__text { max-width: 52ch; }
  @media (min-width: 56em) { .interconnect { grid-template-columns: 0.9fr 1.1fr; gap: var(--space-2xl); align-items: start; } }
</style>
