---
import { getContent } from '../../i18n/content';
import { pathFor, type Locale } from '../../i18n/routes';
import SectionHeading from '../SectionHeading.astro';
import EcosystemDiagram from '../EcosystemDiagram.astro';
import Figure from '../Figure.astro';
import Arrow from '../Arrow.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale);
const h = c.home;
const isFr = locale === 'fr';
const contactHref = pathFor('contact', locale);
const conceptHref = pathFor('concept', locale);
const solutionsHref = pathFor('solutions', locale);
const methodeHref = pathFor('methode', locale);
const aboutHref = pathFor('about', locale);
const replace = (file: string) => (isFr ? `À remplacer · public/images/${file}` : `Replace · public/images/${file}`);
---

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="container">
    <span class="eyebrow" data-reveal>{h.hero.eyebrow}</span>
    <h1 class="hero__title" data-reveal style="--reveal-delay:80ms">{h.hero.titleA} {h.hero.titleB}</h1>
    <div class="hero__row">
      <p class="hero__subtitle" data-reveal style="--reveal-delay:160ms">{h.hero.subtitle}</p>
      <div class="hero__actions" data-reveal style="--reveal-delay:240ms">
        <a class="btn" href={contactHref}>{c.common.ctaPrimary} <Arrow class="arrow" /></a>
        <a class="arrow-link" href={conceptHref}>{c.common.ctaSecondary} <Arrow class="arrow" size={15} /></a>
      </div>
    </div>
  </div>
  <div class="hero__media" data-reveal style="--reveal-delay:200ms">
    <Figure src="/images/hero.jpg" ratio="21 / 9" reveal={false} label={isFr ? 'Photographie d’architecture — plein cadre' : 'Architecture photography — full bleed'} caption={replace('hero.jpg')} />
  </div>
</section>

<!-- ============ CHIFFRES ============ -->
<section class="section--tight figures-band">
  <div class="container">
    <ul class="figures">
      {h.figures.map((f, i) => (
        <li class="figures__item" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <span class="figures__value">{f.value}</span>
          <span class="figures__label">{f.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ============ PROBLÈME ============ -->
<section class="section section--alt">
  <div class="container">
    <SectionHeading eyebrow={h.problem.eyebrow} title={h.problem.title} intro={h.problem.intro} />
    <ul class="cards cards--4">
      {h.problem.items.map((item, i) => (
        <li class="card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <span class="card__index">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="card__title">{item.title}</h3>
          <p class="muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ============ VISION ============ -->
<section class="section">
  <div class="container vision">
    <div class="vision__media" data-reveal>
      <Figure src="/images/vision.jpg" ratio="4 / 5" reveal={false} label={isFr ? 'Intérieur / loft NY' : 'NY interior / loft'} caption={replace('vision.jpg')} />
    </div>
    <div class="vision__text" data-reveal style="--reveal-delay:120ms">
      <span class="eyebrow">{h.vision.eyebrow}</span>
      <h2 class="vision__title">{h.vision.title}</h2>
      <p class="lead">{h.vision.lead}</p>
      <p class="vision__body muted">{h.vision.body}</p>
      <ul class="ticks">
        {h.vision.points.map((p) => (
          <li class="tick"><span class="tick__mark" aria-hidden="true"></span>{p}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- ============ SOLUTIONS (index singulier) ============ -->
<section class="section section--alt">
  <div class="container">
    <SectionHeading eyebrow={h.pillars.eyebrow} title={h.pillars.title} intro={h.pillars.intro} />
    <ol class="index">
      {c.modules.map((m, i) => (
        <li class="index__row" data-reveal style={`--reveal-delay:${i * 50}ms`}>
          <span class="index__no">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="index__name">{m.name}</h3>
          <p class="index__text muted">{m.text}</p>
          <span class="index__abbr">{m.abbr}</span>
        </li>
      ))}
    </ol>
    <a class="arrow-link index__link" href={solutionsHref}>{c.common.ctaSecondary} <Arrow class="arrow" size={15} /></a>
  </div>
</section>

<!-- ============ ÉCOSYSTÈME ============ -->
<section class="section">
  <div class="container">
    <SectionHeading eyebrow={h.ecosystem.eyebrow} title={h.ecosystem.title} intro={h.ecosystem.caption} align="center" />
    <div class="eco-wrap" data-reveal>
      <EcosystemDiagram modules={c.modules} centerLabel={isFr ? 'Socle' : 'Core'} centerSub={isFr ? 'données + IA' : 'data + AI'} />
    </div>
  </div>
</section>

<!-- ============ MÉTHODE ============ -->
<section class="section section--alt">
  <div class="container">
    <SectionHeading eyebrow={h.method.eyebrow} title={h.method.title} intro={h.method.intro} />
    <ol class="steps">
      {h.method.steps.map((s, i) => (
        <li class="step" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <span class="step__n">{s.n}</span>
          <h3 class="step__title">{s.title}</h3>
          <p class="muted step__text">{s.text}</p>
        </li>
      ))}
    </ol>
    <a class="arrow-link steps__link" href={methodeHref}>{isFr ? 'La méthode en détail' : 'The method in detail'} <Arrow class="arrow" size={15} /></a>
  </div>
</section>

<!-- ============ POURQUOI ============ -->
<section class="section">
  <div class="container">
    <SectionHeading eyebrow={h.why.eyebrow} title={h.why.title} />
    <ul class="cards cards--3">
      {h.why.items.map((item, i) => (
        <li class="card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <h3 class="card__title">{item.title}</h3>
          <p class="muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ============ CAS D'USAGE ============ -->
<section class="section section--alt">
  <div class="container">
    <SectionHeading eyebrow={h.useCases.eyebrow} title={h.useCases.title} />
    <ul class="cards cards--3">
      {h.useCases.items.map((item, i) => (
        <li class="card card--use" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <span class="use__tag">{item.tag}</span>
          <h3 class="card__title">{item.title}</h3>
          <p class="muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ============ À PROPOS ============ -->
<section class="section">
  <div class="container about">
    <div class="about__text" data-reveal>
      <span class="eyebrow">{h.about.eyebrow}</span>
      <h2 class="about__title">{h.about.title}</h2>
      <p class="lead">{h.about.text}</p>
      <a class="arrow-link" href={aboutHref}>{h.about.cta} <Arrow class="arrow" size={15} /></a>
    </div>
    <div class="about__media" data-reveal style="--reveal-delay:120ms">
      <Figure src="/images/about.jpg" ratio="3 / 4" reveal={false} label={isFr ? 'Portrait / fondateur' : 'Portrait / founder'} caption={replace('about.jpg')} />
    </div>
  </div>
</section>

<!-- ============ CTA FINAL ============ -->
<section class="section">
  <div class="container">
    <div class="cta" data-reveal>
      <span class="eyebrow eyebrow--plain cta__eyebrow">{h.finalCta.eyebrow}</span>
      <h2 class="cta__title">{h.finalCta.title}</h2>
      <p class="cta__text measure">{h.finalCta.text}</p>
      <a class="btn cta__btn" href={contactHref}>{h.finalCta.button} <Arrow class="arrow" /></a>
      <p class="cta__micro">{h.finalCta.micro}</p>
    </div>
  </div>
</section>

<style>
  /* ---- HERO ---- */
  .hero { padding-top: clamp(2.5rem, 7vh, 5rem); }
  .hero .eyebrow { margin-bottom: var(--space-m); }
  .hero__title {
    font-size: var(--step-6); font-weight: 400; line-height: 1.02;
    letter-spacing: var(--tracking-tight); max-width: 18ch;
  }
  .hero__row { display: flex; flex-direction: column; gap: var(--space-l); margin-top: var(--space-xl); }
  .hero__subtitle { font-size: var(--step-1); line-height: 1.5; color: var(--text-muted); max-width: 52ch; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-m); }
  .hero__media { margin-top: var(--space-xl); padding-inline: var(--gutter); }
  @media (min-width: 60em) {
    .hero__row { flex-direction: row; justify-content: space-between; align-items: flex-end; gap: var(--space-2xl); }
    .hero__subtitle { max-width: 44ch; }
  }

  /* ---- CHIFFRES ---- */
  .figures-band { border-bottom: 1px solid var(--line); }
  .figures { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-l) var(--space-m); }
  .figures__item { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .figures__value { font-family: var(--font-display); font-size: var(--step-4); font-weight: 300; line-height: 1; }
  .figures__label { font-size: var(--step--1); color: var(--text-subtle); }
  @media (min-width: 52em) { .figures { grid-template-columns: repeat(4, 1fr); } }

  /* ---- CARTES ---- */
  .cards { list-style: none; padding: 0; margin: var(--space-xl) 0 0; display: grid; gap: var(--space-m); }
  @media (min-width: 40em) { .cards--3, .cards--4 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 60em) { .cards--3 { grid-template-columns: repeat(3, 1fr); } .cards--4 { grid-template-columns: repeat(4, 1fr); } }
  .card {
    background: var(--surface); border: 1px solid var(--line); padding: var(--space-l);
    display: flex; flex-direction: column; gap: var(--space-xs);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .card:hover { border-color: var(--line-strong); transform: translateY(-3px); }
  .card__index { font-size: var(--step--1); color: var(--text-subtle); letter-spacing: var(--tracking-wide); }
  .card__title { font-size: var(--step-1); font-weight: 500; }
  .use__tag { font-size: var(--step--1); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-subtle); }

  /* ---- VISION ---- */
  .vision { display: grid; gap: var(--space-xl); }
  .vision__title { margin-top: var(--space-s); }
  .vision__text .lead { margin-top: var(--space-m); }
  .vision__body { margin-top: var(--space-m); max-width: 52ch; }
  .ticks { list-style: none; padding: 0; margin: var(--space-l) 0 0; display: grid; gap: var(--space-s); }
  .tick { display: flex; align-items: baseline; gap: var(--space-s); }
  .tick__mark { flex: none; width: 1.2rem; height: 1px; background: var(--ink); transform: translateY(-0.35em); }
  @media (min-width: 56em) { .vision { grid-template-columns: 0.9fr 1.1fr; gap: var(--space-2xl); align-items: center; } }

  /* ---- INDEX (solutions, dispositif singulier) ---- */
  .index { list-style: none; padding: 0; margin: var(--space-xl) 0 0; }
  .index__row {
    display: grid; grid-template-columns: auto 1fr; gap: var(--space-xs) var(--space-l);
    align-items: baseline; padding-block: var(--space-l);
    border-top: 1px solid var(--line-strong); position: relative;
    transition: padding-left var(--dur) var(--ease);
  }
  .index__row:last-child { border-bottom: 1px solid var(--line-strong); }
  .index__row:hover { padding-left: var(--space-s); }
  .index__no { font-size: var(--step--1); color: var(--text-subtle); letter-spacing: var(--tracking-wide); padding-top: 0.5rem; }
  .index__name { font-size: var(--step-3); font-weight: 400; letter-spacing: var(--tracking-tight); }
  .index__text { grid-column: 2; max-width: 60ch; }
  .index__abbr { position: absolute; top: var(--space-l); right: 0; font-size: var(--step--1); letter-spacing: var(--tracking-label); color: var(--text-subtle); }
  .index__link { margin-top: var(--space-xl); }
  @media (min-width: 56em) {
    .index__row { grid-template-columns: 4rem 22rem 1fr; align-items: baseline; gap: var(--space-l); }
    .index__text { grid-column: auto; margin: 0; }
    .index__abbr { position: static; align-self: center; text-align: right; }
  }

  /* ---- ÉCOSYSTÈME ---- */
  .eco-wrap { margin-top: var(--space-2xl); }

  /* ---- ÉTAPES ---- */
  .steps { list-style: none; padding: 0; margin: var(--space-xl) 0 0; display: grid; gap: var(--space-l); }
  @media (min-width: 48em) { .steps { grid-template-columns: repeat(5, 1fr); gap: var(--space-m); } }
  .step { padding-top: var(--space-m); border-top: 1px solid var(--line-strong); display: flex; flex-direction: column; gap: var(--space-2xs); }
  .step__n { font-size: var(--step--1); color: var(--text-subtle); letter-spacing: var(--tracking-wide); }
  .step__title { font-size: var(--step-1); font-weight: 500; }
  .step__text { font-size: var(--step--1); }
  .steps__link { margin-top: var(--space-xl); }

  /* ---- À PROPOS ---- */
  .about { display: grid; gap: var(--space-xl); }
  .about__title { margin-top: var(--space-s); margin-bottom: var(--space-m); }
  @media (min-width: 56em) { .about { grid-template-columns: 1.1fr 0.9fr; gap: var(--space-2xl); align-items: center; } .about__media { order: 2; } }

  /* ---- CTA FINAL ---- */
  .cta {
    background: var(--ink); color: var(--plaster);
    padding: clamp(2.5rem, 7vw, 6rem);
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-m);
  }
  .cta__eyebrow { color: color-mix(in srgb, var(--plaster) 60%, transparent); }
  .cta__title { color: var(--plaster); font-size: var(--step-4); font-weight: 400; max-width: 20ch; }
  .cta__text { color: color-mix(in srgb, var(--plaster) 78%, transparent); }
  .cta__btn { background: var(--plaster); color: var(--ink); border-color: var(--plaster); margin-top: var(--space-s); }
  .cta__btn:hover { background: transparent; color: var(--plaster); }
  .cta__micro { color: color-mix(in srgb, var(--plaster) 50%, transparent); font-size: var(--step--1); }
</style>
