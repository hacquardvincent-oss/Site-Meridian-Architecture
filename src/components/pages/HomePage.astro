---
import { getContent } from '../../i18n/content';
import { Image } from 'astro:assets';
import { photos, fullBleedWidth, fullBleedWidths, FULL_BLEED_SIZES, PHOTO_QUALITY } from '../../assets/images';
import { pathFor, type Locale } from '../../i18n/routes';
import Arrow from '../Arrow.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale);
const h = c.home;
const contactHref = pathFor('contact', locale);
const realisationsHref = pathFor('outils', locale); // route « Outils » relabellisée « Réalisations »
const solutionsHref = pathFor('solutions', locale); // « Ce que nous automatisons » — les cinq formes
---

{/* =====================================================================
    ACCUEIL — cinq temps (POSITIONNEMENT.md § 5) :
    1 · la frontière · 2 · les trois marches · 3 · une preuve par marche
    4 · la règle de la maison · 5 · une seule action.
    Système visuel inchangé (panneaux empilés, hero photo, DA). Le style
    ne change pas ; la structure et le discours, oui.
   ===================================================================== */}
<div class="stack" data-stack>

  {/* ============ 01 · LA FRONTIÈRE — hero photo, sombre ============ */}
  <section class="panel panel--hero" style="--i:1" data-hero data-section-theme="dark">
    <div class="panel__card hero">
      <div class="hero__media">
        <Image class="hero__img" src={photos.hero} width={fullBleedWidth(photos.hero)} widths={fullBleedWidths(photos.hero)} sizes={FULL_BLEED_SIZES} format="webp" quality={PHOTO_QUALITY} alt="" fetchpriority="high" loading="eager" decoding="async" />
        <div class="hero__scrim"></div>
        <svg class="hero__geo" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <path d="M64 64 H128 M64 64 V128" stroke="#ffffff" stroke-width="1.2" opacity="0.45" />
          <path d="M1136 736 H1072 M1136 736 V672" stroke="#ffffff" stroke-width="1.2" opacity="0.45" />
          <circle cx="1090" cy="112" r="5" fill="#9db8dd" />
        </svg>
      </div>

      <div class="container hero__inner">
        <span class="eyebrow hero__eyebrow" data-reveal>{h.frontiere.eyebrow}</span>
        <h1 class="frontier" data-reveal style="--reveal-delay:80ms">
          <span class="frontier__b">{h.frontiere.title}</span>
        </h1>
        <p class="frontier__sub" data-reveal style="--reveal-delay:160ms">{h.frontiere.sub}</p>
      </div>

      <div class="hero__foot">
        <div class="container hero__foot-row">
          <span class="hero__coord">40.71°N 74.00°W</span>
          <span class="hero__cue">{h.frontiere.cue} ↓</span>
        </div>
      </div>
    </div>
  </section>

  {/* ============ 02 · LES TROIS PILIERS — clair ============ */}
  <section class="panel panel--paper" style="--i:2" data-section-theme="light">
    <div class="panel__card panel__card--pad">
      <div class="container">
        <span class="eyebrow" data-reveal>{h.piliers.eyebrow}</span>
        <h2 class="secttl" data-reveal style="--reveal-delay:80ms">{h.piliers.title}</h2>
        <p class="sectintro muted" data-reveal style="--reveal-delay:120ms">{h.piliers.intro}</p>
        <ol class="hpil">
          {h.piliers.items.map((p, i) => (
            <li class="hpil__item" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="hpil__n mono">{p.n}</span>
              <div class="hpil__body">
                <h3 class="hpil__name">{p.name}</h3>
                <p class="hpil__what">{p.what}</p>
                <p class="hpil__ex muted">{p.examples}</p>
              </div>
            </li>
          ))}
        </ol>
        <a class="arrow-link hpil__link" href={solutionsHref}>{h.piliers.link} <Arrow class="arrow" size={15} /></a>
      </div>
    </div>
  </section>

  {/* ============ 03 · UNE PREUVE PAR MARCHE — clair (alt) ============ */}
  <section class="panel panel--alt" style="--i:3" data-section-theme="light">
    <div class="panel__card panel__card--pad">
      <div class="container">
        <span class="eyebrow" data-reveal>{h.preuves.eyebrow}</span>
        <h2 class="secttl" data-reveal style="--reveal-delay:80ms">{h.preuves.title}</h2>
        <p class="sectintro muted" data-reveal style="--reveal-delay:120ms">{h.preuves.intro}</p>
        <ul class="proofs">
          {h.preuves.items.map((p, i) => (
            <li class="proof" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="proof__marche mono">{p.marche}</span>
              <span class:list={['proof__value', { 'proof__value--pending': p.pending }]}>{p.value}</span>
              <p class="proof__label muted">{p.label}</p>
              <span class="proof__source">{p.source}</span>
            </li>
          ))}
        </ul>
        <a class="arrow-link proofs__link" href={realisationsHref}>{h.preuves.link} <Arrow class="arrow" size={15} /></a>
      </div>
    </div>
  </section>

  {/* ============ 04 · LA RÈGLE DE LA MAISON — bandeau photo, sombre ============ */}
  <section class="panel panel--band" style="--i:4" aria-label={h.regle.eyebrow} data-section-theme="dark">
    <div class="panel__card photoband">
      <Image class="photoband__img" src={photos.band} width={fullBleedWidth(photos.band)} widths={fullBleedWidths(photos.band)} sizes={FULL_BLEED_SIZES} format="webp" quality={PHOTO_QUALITY} alt="" loading="lazy" decoding="async" data-parallax />
      <div class="photoband__scrim"></div>
      <div class="container photoband__inner regle" data-reveal>
        <span class="photoband__eyebrow">{h.regle.eyebrow}</span>
        <p class="regle__quote">{h.regle.quoteA} <span class="regle__quote-b">{h.regle.quoteB}</span></p>
        <p class="regle__body">{h.regle.body}</p>
      </div>
    </div>
  </section>

  {/* ============ 05 · UNE SEULE ACTION — sombre ============ */}
  <section class="panel panel--cta" style="--i:5" data-section-theme="dark">
    <div class="panel__card panel__card--pad">
      <div class="container">
        <div class="cta" data-reveal>
          <span class="eyebrow eyebrow--plain cta__eyebrow">{h.action.eyebrow}</span>
          <h2 class="cta__title">{h.action.title}</h2>
          <p class="cta__text measure">{h.action.text}</p>
          <a class="btn cta__btn" href={contactHref}>{h.action.button} <Arrow class="arrow" /></a>
          <p class="cta__micro">{h.action.micro}</p>
        </div>
      </div>
    </div>
  </section>

</div>

<style>
  /* =====================================================================
     SYSTÈME DE PANNEAUX EMPILÉS (repris tel quel de la charte)
     Par défaut (mobile < 60em et prefers-reduced-motion) : FLUX NORMAL.
     ===================================================================== */
  @property --dim { syntax: '<number>'; inherits: true; initial-value: 0; }

  .stack { position: relative; }
  .panel { position: relative; }
  .panel__card { position: relative; --dim: 0; }
  .panel__card::after {
    content: ''; position: absolute; inset: 0; z-index: 5;
    background: #08080a; opacity: var(--dim, 0); pointer-events: none;
  }

  .panel--paper > .panel__card { background: var(--plaster); }
  .panel--alt > .panel__card { background: var(--plaster-deep); }
  .panel--cta > .panel__card { background: var(--ink); color: var(--plaster); }
  .panel__card--pad { padding-block: var(--space-2xl); }

  /* ---- HERO (image plein écran) ---- */
  .hero { position: relative; min-height: 100vh; min-height: 100svh; display: grid; background: var(--ink); color: #fff; overflow: hidden; }
  .hero__media { position: absolute; inset: 0; z-index: 0; }
  .hero__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero__scrim { position: absolute; inset: 0; background:
    linear-gradient(90deg, rgba(12,12,15,0.82) 0%, rgba(12,12,15,0.5) 44%, rgba(12,12,15,0.12) 74%, rgba(12,12,15,0.34) 100%),
    linear-gradient(180deg, rgba(12,12,15,0.28) 0%, rgba(12,12,15,0.08) 45%, rgba(12,12,15,0.62) 100%); }
  .hero__geo { position: absolute; inset: 0; width: 100%; height: 100%; }

  .hero__inner { position: relative; z-index: 2; align-self: center; width: 100%; padding-block: var(--space-2xl); }
  .hero .eyebrow { color: rgba(255,255,255,0.72); margin-bottom: var(--space-l); }
  .hero .eyebrow::before { background: rgba(255,255,255,0.45); }

  /* ---- LA FRONTIÈRE (la phrase, et rien d'autre) ---- */
  .frontier { display: flex; flex-direction: column; gap: var(--space-m); max-width: 30ch; font-weight: 400; letter-spacing: var(--tracking-tight); }
  .frontier__b { color: #fff; font-size: var(--step-5); line-height: 1.05; }
  .frontier__sub { color: rgba(255,255,255,0.8); font-size: var(--step-1); line-height: var(--leading-normal); max-width: 46ch; margin-top: var(--space-m); }

  .hero__foot { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding-bottom: var(--space-l); }
  .hero__foot-row { display: flex; justify-content: space-between; align-items: center; font-size: var(--step--1); letter-spacing: var(--tracking-wide); color: rgba(255,255,255,0.6); }
  .hero__coord { color: var(--accent); }

  /* ---- Titres de section génériques ---- */
  .secttl { margin-top: var(--space-s); }
  .sectintro { margin-top: var(--space-m); max-width: 60ch; }

  /* ---- LES TROIS PILIERS ---- */
  .hpil { list-style: none; padding: 0; margin: var(--space-2xl) 0 0; display: grid; gap: var(--space-xl); }
  .hpil__item { display: grid; grid-template-columns: auto 1fr; gap: var(--space-s) var(--space-m); padding-top: var(--space-l); border-top: 1px solid var(--line-strong); }
  .hpil__n { grid-row: span 3; font-size: var(--step-0); color: var(--ink); letter-spacing: var(--tracking-wide); padding-top: 0.35em; }
  .hpil__name { font-size: var(--step-3); font-weight: 400; letter-spacing: var(--tracking-tight); line-height: 1.05; }
  .hpil__what { margin-top: var(--space-2xs); font-size: var(--step-1); color: var(--ink); line-height: var(--leading-tight); }
  .hpil__ex { margin-top: var(--space-s); font-size: var(--step-0); max-width: 64ch; line-height: var(--leading-normal); }
  .hpil__link { margin-top: var(--space-xl); }

  /* ---- LES PREUVES ---- */
  .proofs { list-style: none; padding: 0; margin: var(--space-2xl) 0 0; display: grid; gap: var(--space-l); }
  @media (min-width: 56em) { .proofs { grid-template-columns: repeat(3, 1fr); gap: var(--space-l); } }
  .proof { display: flex; flex-direction: column; gap: var(--space-2xs); padding-top: var(--space-m); border-top: 1px solid var(--line-strong); }
  .proof__marche { font-size: var(--step--1); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--text-subtle); }
  .proof__value { font-family: var(--font-display); font-weight: 300; font-size: var(--step-5); line-height: 1; letter-spacing: var(--tracking-tight); color: var(--ink); margin-top: var(--space-2xs); }
  .proof__value--pending { font-size: var(--step-1); font-weight: 500; color: var(--text-subtle); font-family: var(--font-sans); letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .proof__label { margin-top: var(--space-2xs); font-size: var(--step--1); max-width: 40ch; }
  .proof__source { margin-top: auto; padding-top: var(--space-s); font-size: var(--step--1); color: var(--text); letter-spacing: var(--tracking-wide); }
  .proofs__link { margin-top: var(--space-xl); }

  /* ---- BANDEAU PHOTO / LA RÈGLE ---- */
  .photoband { position: relative; min-height: 100vh; display: grid; place-items: center; overflow: hidden; background: var(--ink); color: #fff; }
  .photoband__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .photoband__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,12,15,0.58) 0%, rgba(12,12,15,0.4) 45%, rgba(12,12,15,0.66) 100%); }
  .photoband__inner { position: relative; z-index: 2; text-align: center; padding-block: var(--space-2xl); }
  .photoband__eyebrow { display: inline-block; font-size: var(--step--1); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--accent); margin-bottom: var(--space-l); }
  .regle__quote { font-family: var(--font-display); font-weight: 400; font-size: var(--step-4); line-height: 1.14; letter-spacing: var(--tracking-tight); max-width: 32ch; margin: 0 auto; color: #fff; }
  .regle__quote-b { color: rgba(255,255,255,0.66); }
  .regle__body { max-width: 46ch; margin: var(--space-l) auto 0; font-size: var(--step-0); line-height: var(--leading-normal); color: rgba(255,255,255,0.82); }

  /* ---- CTA / UNE SEULE ACTION ---- */
  .cta { background: var(--ink); color: var(--plaster); padding: clamp(2.5rem, 7vw, 6rem); display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-m); }
  .cta__eyebrow { color: color-mix(in srgb, var(--plaster) 60%, transparent); }
  .cta__title { color: var(--plaster); font-size: var(--step-4); font-weight: 400; max-width: 28ch; }
  .cta__text { color: color-mix(in srgb, var(--plaster) 78%, transparent); }
  .cta__btn { background: var(--plaster); color: var(--ink); border-color: var(--plaster); margin-top: var(--space-s); }
  .cta__btn:hover { background: transparent; color: var(--plaster); }
  .cta__micro { color: color-mix(in srgb, var(--plaster) 50%, transparent); font-size: var(--step--1); }

  /* =====================================================================
     EMPILEMENT « STICKY STACKING » — desktop, hors reduced-motion
     ===================================================================== */
  @media (min-width: 60em) and (prefers-reduced-motion: no-preference) {
    .stack { background: var(--ink); }
    .panel { position: sticky; top: 0; min-height: 100vh; }
    .panel__card { min-height: 100vh; }
    .panel__card--pad {
      display: flex; flex-direction: column; justify-content: center;
      padding-block: clamp(4.75rem, 7.5vh, 6.5rem) var(--space-l);
    }
    .secttl { font-size: var(--step-3); }
    .hpil { margin-top: var(--space-xl); }
    .proofs { margin-top: var(--space-xl); }

    @supports (animation-timeline: scroll()) {
      .panel__card {
        --n: 5;
        --i0: calc(var(--i, 1) - 1);
        transform-origin: 50% 50%;
        animation: panelRecede linear both;
        animation-timeline: scroll(root);
        animation-range: calc(var(--i0) / var(--n) * 100%) calc(var(--i, 1) / var(--n) * 100%);
        backface-visibility: hidden;
      }
      .panel:last-child .panel__card { animation: none; }
    }
  }

  @keyframes panelRecede {
    from { transform: scale(1); --dim: 0; }
    to   { transform: scale(0.92); --dim: 0.5; }
  }
</style>

<script>
  // Smooth-scroll « inertie » (Lenis), désactivé sous reduced-motion.
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  const reduceMQ = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!reduceMQ.matches) {
    const lenis = new Lenis({
      duration: 1.15,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true, wheelMultiplier: 1, touchMultiplier: 1.2,
    });
    (window as any).lenis = lenis;
    const raf = (time: number) => { lenis.raf(time); requestAnimationFrame(raf); };
    requestAnimationFrame(raf);
  }
</script>
