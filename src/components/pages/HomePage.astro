---
import { getContent } from '../../i18n/content';
import { pathFor, type Locale } from '../../i18n/routes';
import SectionHeading from '../SectionHeading.astro';
import EcosystemDiagram from '../EcosystemDiagram.astro';
import Arrow from '../Arrow.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale);
const h = c.home;
const contactHref = pathFor('contact', locale);
const conceptHref = pathFor('concept', locale);
const solutionsHref = pathFor('solutions', locale);
const methodeHref = pathFor('methode', locale);
const aboutHref = pathFor('about', locale);
---

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    <svg viewBox="0 0 600 600" preserveAspectRatio="xMidYMid slice" class="hero__plan">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M40 0H0V40" fill="none" stroke="currentColor" stroke-width="0.5" />
        </pattern>
      </defs>
      <rect width="600" height="600" fill="url(#grid)" opacity="0.5" />
      <circle cx="430" cy="300" r="190" fill="none" stroke="currentColor" stroke-width="1" />
      <ellipse cx="430" cy="300" rx="74" ry="190" fill="none" stroke="currentColor" stroke-width="1" />
      <line x1="430" y1="100" x2="430" y2="500" stroke="currentColor" stroke-width="1" />
      <line x1="230" y1="300" x2="630" y2="300" stroke="var(--brass)" stroke-width="1" opacity="0.6" />
      <line x1="40" y1="60" x2="120" y2="60" stroke="currentColor" stroke-width="1" />
      <line x1="40" y1="52" x2="40" y2="68" stroke="currentColor" stroke-width="1" />
      <line x1="120" y1="52" x2="120" y2="68" stroke="currentColor" stroke-width="1" />
    </svg>
  </div>

  <div class="container hero__inner">
    <span class="eyebrow" data-reveal>{h.hero.eyebrow}</span>
    <h1 class="hero__title" data-reveal style="--reveal-delay:80ms">
      <span class="hero__title-a">{h.hero.titleA}</span>
      <span class="hero__title-b">{h.hero.titleB}</span>
    </h1>
    <p class="hero__subtitle measure" data-reveal style="--reveal-delay:160ms">{h.hero.subtitle}</p>
    <div class="hero__actions" data-reveal style="--reveal-delay:240ms">
      <a class="btn" href={contactHref}>{c.common.ctaPrimary} <Arrow class="arrow" /></a>
      <a class="btn btn--ghost" href={conceptHref}>{c.common.ctaSecondary}</a>
    </div>
  </div>

  <div class="container hero__scroll" aria-hidden="true">
    <span class="mono">{h.hero.scrollHint}</span>
    <span class="hero__scroll-line"></span>
  </div>
</section>

<!-- ============ FIGURES ============ -->
<section class="figures section--tight section--alt">
  <div class="container">
    <ul class="figures__grid">
      {h.figures.map((f, i) => (
        <li class="figures__item" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <span class="figures__value">{f.value}</span>
          <span class="figures__label">{f.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ============ PROBLÈME ============ -->
<section class="section">
  <div class="container">
    <SectionHeading eyebrow={h.problem.eyebrow} title={h.problem.title} intro={h.problem.intro} />
    <ul class="cards cards--4">
      {h.problem.items.map((item, i) => (
        <li class="card card--problem" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <span class="card__index mono">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="card__title">{item.title}</h3>
          <p class="muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ============ VISION ============ -->
<section class="section section--alt">
  <div class="container vision">
    <div class="vision__head" data-reveal>
      <span class="eyebrow">{h.vision.eyebrow}</span>
      <h2 class="vision__title">{h.vision.title}</h2>
      <p class="lead">{h.vision.lead}</p>
    </div>
    <div class="vision__body" data-reveal style="--reveal-delay:120ms">
      <p class="vision__text measure">{h.vision.body}</p>
      <ul class="vision__points">
        {h.vision.points.map((p) => (
          <li class="vision__point"><span class="vision__tick" aria-hidden="true"></span>{p}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- ============ PILIERS ============ -->
<section class="section">
  <div class="container">
    <SectionHeading eyebrow={h.pillars.eyebrow} title={h.pillars.title} intro={h.pillars.intro} />
    <ul class="cards cards--3 pillars">
      {c.modules.map((m, i) => (
        <li class="card card--pillar" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <span class="pillar__abbr mono">{m.abbr}</span>
          <h3 class="pillar__name">{m.name}</h3>
          <p class="muted">{m.text}</p>
        </li>
      ))}
      <li class="card card--pillar card--note" data-reveal style={`--reveal-delay:${c.modules.length * 60}ms`}>
        <span class="pillar__plus" aria-hidden="true">+</span>
        <p class="muted">{h.pillars.note}</p>
        <a class="arrow-link" href={solutionsHref}>{c.common.ctaSecondary} <Arrow class="arrow" size={16} /></a>
      </li>
    </ul>
  </div>
</section>

<!-- ============ ÉCOSYSTÈME / INTERCONNEXION ============ -->
<section class="section section--alt">
  <div class="container">
    <SectionHeading eyebrow={h.ecosystem.eyebrow} title={h.ecosystem.title} intro={h.ecosystem.caption} align="center" />
    <div class="eco-wrap" data-reveal>
      <EcosystemDiagram modules={c.modules} centerLabel={locale === 'fr' ? 'Socle' : 'Core'} centerSub={locale === 'fr' ? 'données + IA' : 'data + AI'} />
    </div>
  </div>
</section>

<!-- ============ MÉTHODE ============ -->
<section class="section">
  <div class="container">
    <SectionHeading eyebrow={h.method.eyebrow} title={h.method.title} intro={h.method.intro} />
    <ol class="steps">
      {h.method.steps.map((s, i) => (
        <li class="step" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <span class="step__n mono">{s.n}</span>
          <h3 class="step__title">{s.title}</h3>
          <p class="muted step__text">{s.text}</p>
        </li>
      ))}
    </ol>
    <a class="arrow-link steps__link" href={methodeHref}>{locale === 'fr' ? 'La méthode en détail' : 'The method in detail'} <Arrow class="arrow" size={16} /></a>
  </div>
</section>

<!-- ============ POURQUOI ============ -->
<section class="section section--alt">
  <div class="container">
    <SectionHeading eyebrow={h.why.eyebrow} title={h.why.title} />
    <ul class="cards cards--3">
      {h.why.items.map((item, i) => (
        <li class="card card--why" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <h3 class="card__title">{item.title}</h3>
          <p class="muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ============ CAS D'USAGE ============ -->
<section class="section">
  <div class="container">
    <SectionHeading eyebrow={h.useCases.eyebrow} title={h.useCases.title} />
    <ul class="cards cards--3">
      {h.useCases.items.map((item, i) => (
        <li class="card card--use" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <span class="use__tag mono">{item.tag}</span>
          <h3 class="use__title">{item.title}</h3>
          <p class="muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ============ À PROPOS (teaser) ============ -->
<section class="section section--alt">
  <div class="container about-teaser" data-reveal>
    <div class="about-teaser__head">
      <span class="eyebrow">{h.about.eyebrow}</span>
      <h2 class="about-teaser__title">{h.about.title}</h2>
    </div>
    <div class="about-teaser__body">
      <p class="lead">{h.about.text}</p>
      <a class="arrow-link" href={aboutHref}>{h.about.cta} <Arrow class="arrow" size={16} /></a>
    </div>
  </div>
</section>

<!-- ============ CTA FINAL ============ -->
<section class="section">
  <div class="container">
    <div class="cta-panel" data-reveal>
      <span class="eyebrow eyebrow--plain cta-panel__eyebrow">{h.finalCta.eyebrow}</span>
      <h2 class="cta-panel__title">{h.finalCta.title}</h2>
      <p class="cta-panel__text measure">{h.finalCta.text}</p>
      <a class="btn btn--brass cta-panel__btn" href={contactHref}>{h.finalCta.button} <Arrow class="arrow" /></a>
      <p class="cta-panel__micro mono">{h.finalCta.micro}</p>
    </div>
  </div>
</section>

<style>
  /* ---- HERO ---- */
  .hero { position: relative; padding-block: clamp(4rem, 12vh, 9rem) var(--space-2xl); overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; pointer-events: none; }
  .hero__plan {
    position: absolute; top: 50%; right: -8%; transform: translateY(-50%);
    width: min(58rem, 85%); height: auto; color: var(--line-strong); opacity: 0.55;
  }
  .hero__inner { position: relative; display: flex; flex-direction: column; gap: var(--space-m); }
  .hero__title { font-size: var(--step-6); display: flex; flex-direction: column; }
  .hero__title-b { color: var(--ink); }
  .hero__title-a { position: relative; width: fit-content; }
  .hero__subtitle { font-size: var(--step-1); line-height: 1.45; color: var(--text-muted); margin-top: var(--space-s); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-s); margin-top: var(--space-m); }
  .hero__scroll { position: relative; display: flex; align-items: center; gap: var(--space-s); margin-top: var(--space-2xl); color: var(--text-subtle); font-size: var(--step--1); }
  .hero__scroll-line { display: inline-block; width: 4rem; height: 1px; background: var(--line-strong); position: relative; overflow: hidden; }
  .hero__scroll-line::after { content: ''; position: absolute; inset: 0; width: 40%; background: var(--brass); animation: slide 2.4s var(--ease) infinite; }
  @keyframes slide { 0% { transform: translateX(-110%); } 100% { transform: translateX(260%); } }
  @media (prefers-reduced-motion: reduce) { .hero__scroll-line::after { animation: none; } }

  /* ---- FIGURES ---- */
  .figures__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-l) var(--space-m); }
  .figures__item { display: flex; flex-direction: column; gap: 0.35rem; padding-left: var(--space-m); border-left: 1px solid var(--line-strong); }
  .figures__value { font-family: var(--font-display); font-size: var(--step-4); font-weight: 500; line-height: 1; }
  .figures__label { font-size: var(--step--1); color: var(--text-subtle); }
  @media (min-width: 52em) { .figures__grid { grid-template-columns: repeat(4, 1fr); } }

  /* ---- CARTES (génériques) ---- */
  .cards { list-style: none; padding: 0; margin: var(--space-xl) 0 0; display: grid; gap: var(--space-m); }
  @media (min-width: 40em) { .cards--3, .cards--4 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 60em) { .cards--3 { grid-template-columns: repeat(3, 1fr); } .cards--4 { grid-template-columns: repeat(4, 1fr); } }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-l);
    display: flex; flex-direction: column; gap: var(--space-xs);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .card:hover { border-color: var(--line-strong); transform: translateY(-3px); }
  .card__index { color: var(--accent-text); font-size: var(--step--1); }
  .card__title { font-size: var(--step-1); }

  /* ---- PILIERS ---- */
  .pillar__abbr { font-size: var(--step-2); color: var(--ink); letter-spacing: 0.02em; }
  .pillar__name { font-size: var(--step-1); margin-top: var(--space-2xs); }
  .card--note { justify-content: space-between; background: transparent; border-style: dashed; }
  .pillar__plus { font-family: var(--font-display); font-size: var(--step-3); color: var(--accent); line-height: 1; }

  /* ---- VISION ---- */
  .vision { display: grid; gap: var(--space-xl); }
  .vision__title { margin-top: var(--space-s); }
  .vision__head .lead { margin-top: var(--space-s); }
  .vision__points { list-style: none; padding: 0; margin: var(--space-l) 0 0; display: grid; gap: var(--space-s); }
  .vision__point { display: flex; align-items: baseline; gap: var(--space-s); font-size: var(--step-0); }
  .vision__tick { flex: none; width: 1.1rem; height: 1px; background: var(--brass); transform: translateY(-0.35em); }
  @media (min-width: 56em) { .vision { grid-template-columns: 0.9fr 1.1fr; gap: var(--space-2xl); } }

  /* ---- ÉCOSYSTÈME ---- */
  .eco-wrap { margin-top: var(--space-2xl); }

  /* ---- ÉTAPES ---- */
  .steps { list-style: none; padding: 0; margin: var(--space-xl) 0 0; display: grid; gap: var(--space-l); counter-reset: step; }
  @media (min-width: 48em) { .steps { grid-template-columns: repeat(5, 1fr); gap: var(--space-m); } }
  .step { padding-top: var(--space-m); border-top: 1px solid var(--line-strong); display: flex; flex-direction: column; gap: var(--space-2xs); }
  .step__n { color: var(--accent-text); font-size: var(--step--1); }
  .step__title { font-size: var(--step-1); }
  .step__text { font-size: var(--step--1); }
  .steps__link { margin-top: var(--space-xl); }

  /* ---- CAS D'USAGE ---- */
  .use__tag { font-size: 0.72rem; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--accent-text); }
  .use__title { font-size: var(--step-1); margin-top: var(--space-2xs); }

  /* ---- À PROPOS teaser ---- */
  .about-teaser { display: grid; gap: var(--space-l); }
  .about-teaser__title { margin-top: var(--space-s); }
  .about-teaser__body { display: flex; flex-direction: column; gap: var(--space-m); }
  @media (min-width: 56em) { .about-teaser { grid-template-columns: 1fr 1fr; gap: var(--space-2xl); align-items: center; } }

  /* ---- CTA PANEL ---- */
  .cta-panel {
    background: var(--ink); color: var(--plaster);
    border-radius: var(--radius-lg);
    padding: clamp(2.5rem, 6vw, 5rem);
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-m);
    position: relative; overflow: hidden;
  }
  .cta-panel::before {
    content: ''; position: absolute; top: -40%; right: -10%; width: 26rem; height: 26rem;
    border: 1px solid color-mix(in srgb, var(--plaster) 14%, transparent); border-radius: 50%; pointer-events: none;
  }
  .cta-panel__eyebrow { color: var(--brass); }
  .cta-panel__title { color: var(--plaster); font-size: var(--step-4); max-width: 18ch; }
  .cta-panel__text { color: color-mix(in srgb, var(--plaster) 78%, transparent); }
  .cta-panel__btn { margin-top: var(--space-s); }
  .cta-panel__micro { color: color-mix(in srgb, var(--plaster) 50%, transparent); font-size: var(--step--1); }
</style>
