---
import { getContent } from '../../i18n/content';
import { pathFor, withBase, type Locale } from '../../i18n/routes';
import Arrow from '../Arrow.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const data = getContent(locale);
const c = data.contact;
const f = c.form;
const privacyHref = pathFor('confidentialite', locale);
const needTypes = locale === 'fr'
  ? ['Automatisation', 'Outil sur-mesure', 'Site', 'App', 'Widget', 'Autre']
  : ['Automation', 'Bespoke tool', 'Website', 'App', 'Widget', 'Other'];
---
<section class="chero" data-section-theme="dark">
  <div class="chero__media">
    <img class="chero__img" src={withBase('/images/contact.jpg')} alt="" fetchpriority="high" data-parallax />
    <div class="chero__scrim"></div>
  </div>

  <div class="container chero__grid">
    <div class="cintro__head" data-reveal>
      <span class="eyebrow cintro__eyebrow">{c.hero.eyebrow}</span>
      <h1 class="cintro__title">{c.hero.title}</h1>
    </div>

    <form class="ccard" data-contact-form data-email={data.site.email} novalidate data-reveal style="--reveal-delay:120ms">
      <input type="hidden" name="_subject" value="Nouvelle demande — meridian-architecture.com" />
      <input type="hidden" name="_template" value="box" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="ccard__grid">
        <div class="field">
          <label for="prenom">{f.firstName}</label>
          <input id="prenom" name="Prénom" type="text" autocomplete="given-name" required />
        </div>
        <div class="field">
          <label for="nom">{f.lastName}</label>
          <input id="nom" name="Nom" type="text" autocomplete="family-name" required />
        </div>
        <div class="field">
          <label for="email">{f.email}</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="entreprise">{f.company}</label>
          <input id="entreprise" name="Entreprise" type="text" autocomplete="organization" />
        </div>
      </div>

      <fieldset class="chips">
        <legend class="chips__legend">{f.needTypeLabel}</legend>
        <div class="chips__row">
          {needTypes.map((t, i) => (
            <label class="chip">
              <input type="radio" name="Besoin" value={t} required={i === 0} />
              <span>{t}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="field">
        <label for="message">{f.message}</label>
        <textarea id="message" name="Message" rows="2" placeholder={f.placeholderMessage} required></textarea>
      </div>

      <button class="btn btn--brass ccard__btn" type="submit">{f.submit} <Arrow class="arrow" /></button>
      <p class="ccard__note mono">{f.note} <a class="ccard__notelink" href={privacyHref}>{f.noteLink} →</a></p>
      <p class="ccard__success" data-success hidden>{f.success}</p>
      <p class="ccard__error" data-error hidden>{f.error}</p>
    </form>

    <div class="cintro__body" data-reveal style="--reveal-delay:80ms">
      <p class="cintro__lead">{c.hero.lead}</p>
      <dl class="cintro__details">
        <div>
          <dt class="mono">{c.details.emailLabel}</dt>
          <dd><a class="cintro__mail" href={`mailto:${data.site.email}`}>{data.site.email}</a></dd>
        </div>
        {data.site.phone && (
          <div>
            <dt class="mono">{c.details.phoneLabel}</dt>
            <dd><a class="cintro__mail" href={`tel:${data.site.phone.replace(/\s+/g, '')}`}>{data.site.phone}</a></dd>
          </div>
        )}
        <div>
          <dt class="mono">{c.details.responseLabel}</dt>
          <dd>{c.details.response}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .chero { position: relative; min-height: 100svh; display: grid; align-items: center; overflow: hidden; background: var(--ink); color: #fff; padding-block: calc(4.75rem + var(--space-s)) var(--space-l); }
  .chero__media { position: absolute; inset: 0; z-index: 0; }
  .chero__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .chero__scrim { position: absolute; inset: 0; background:
    linear-gradient(100deg, rgba(12,12,15,0.86) 0%, rgba(12,12,15,0.66) 38%, rgba(12,12,15,0.4) 70%, rgba(12,12,15,0.6) 100%); }
  .chero__grid { position: relative; z-index: 2; display: grid; gap: var(--space-xl); }
  .cintro__head, .cintro__body { max-width: 34rem; }
  @media (min-width: 60em) {
    .chero__grid {
      grid-template-columns: 1fr minmax(28rem, 34rem);
      grid-template-areas: "head form" "body form";
      column-gap: var(--space-3xl); row-gap: var(--space-l);
      align-items: start;
    }
    .cintro__head { grid-area: head; align-self: end; }
    .cintro__body { grid-area: body; align-self: start; }
    .ccard { grid-area: form; align-self: center; }
  }
  .cintro__eyebrow { color: rgba(255,255,255,0.72); }
  .cintro__eyebrow::before { background: rgba(255,255,255,0.45); }
  .cintro__title { font-size: var(--step-5); font-weight: 400; line-height: 1.04; letter-spacing: var(--tracking-tight); margin-top: var(--space-m); color: #fff; }
  .cintro__lead { font-size: var(--step-1); line-height: var(--leading-normal); color: rgba(255,255,255,0.84); margin-top: var(--space-m); max-width: 40ch; }
  .cintro__details { display: grid; gap: var(--space-m); margin-top: var(--space-xl); }
  .cintro__details dt { font-size: var(--step--1); letter-spacing: var(--tracking-label); text-transform: uppercase; color: rgba(255,255,255,0.56); margin-bottom: var(--space-3xs); }
  .cintro__details dd { font-size: var(--step-0); color: rgba(255,255,255,0.9); }
  .cintro__mail { color: #fff; border-bottom: 1px solid var(--accent); padding-bottom: 1px; }

  .ccard { background: var(--plaster); color: var(--ink); border-radius: var(--radius-lg); padding: clamp(1.25rem, 3vw, 2rem); box-shadow: 0 30px 70px -28px rgba(0,0,0,0.55); display: grid; gap: var(--space-m); }
  .ccard__grid { display: grid; gap: var(--space-s) var(--space-l); }
  @media (min-width: 30em) { .ccard__grid { grid-template-columns: 1fr 1fr; } }
  .field { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .field label { font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.04em; color: var(--text-subtle); text-transform: uppercase; }
  .field input, .field textarea {
    background: transparent; border: 0; border-bottom: 1px solid var(--line-strong);
    padding: 0.55rem 0; font-size: var(--step-0); color: var(--ink); border-radius: 0;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .field textarea { resize: vertical; }
  .field input:focus, .field textarea:focus { outline: none; border-bottom-color: var(--ink); }

  .chips { border: 0; padding: 0; margin: 0; display: grid; gap: var(--space-s); }
  .chips__legend { font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.04em; color: var(--text-subtle); text-transform: uppercase; padding: 0; }
  .chips__row { display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
  .chip { display: inline-flex; }
  .chip input { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; }
  .chip span {
    display: inline-block; padding: 0.5rem 0.95rem; border: 1px solid var(--line-strong); border-radius: 100px;
    font-size: var(--step--1); color: var(--text); cursor: pointer; user-select: none;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .chip span:hover { border-color: var(--ink); color: var(--ink); }
  .chip input:checked + span { background: var(--ink); color: var(--plaster); border-color: var(--ink); }
  .chip input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }

  .ccard__btn { justify-self: start; }
  .ccard__note { font-size: var(--step--1); color: var(--text-subtle); }
  .ccard__notelink { color: var(--ink); border-bottom: 1px solid var(--line-strong); padding-bottom: 1px; white-space: nowrap; }
  .ccard__notelink:hover { border-bottom-color: var(--ink); }
  .ccard__success { padding: var(--space-m); border: 1px solid var(--brass); border-radius: var(--radius); color: var(--ink); background: var(--brass-wash); }
  .ccard__error { padding: var(--space-m); border: 1px solid var(--line-strong); border-radius: var(--radius); color: var(--ink); background: var(--plaster-deep); font-size: var(--step--1); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>

<script>
  const form = document.querySelector('[data-contact-form]') as HTMLFormElement | null;
  const success = document.querySelector('[data-success]') as HTMLElement | null;
  const errorEl = document.querySelector('[data-error]') as HTMLElement | null;
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  if (form && success && errorEl && submitBtn) {
    const original = submitBtn.innerHTML;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      errorEl.hidden = true;
      submitBtn.disabled = true;
      submitBtn.textContent = '…';
      try {
        const endpoint = `https://formsubmit.co/ajax/${encodeURIComponent(form.dataset.email || '')}`;
        const res = await fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (res.ok && (data.success === true || data.success === 'true')) {
          success.hidden = false;
          form.querySelectorAll('input, textarea, select, button').forEach((el) => {
            (el as HTMLInputElement).disabled = true;
          });
          success.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          throw new Error((data as { message?: string }).message || 'send failed');
        }
      } catch {
        errorEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.innerHTML = original;
      }
    });
  }
</script>
