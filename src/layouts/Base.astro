---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { pathFor, withBase, type Locale } from '../i18n/routes';
import { getContent } from '../i18n/content';

interface Props {
  title: string;
  description: string;
  pageId: string;
  locale: Locale;
  ogImage?: string;
  /** Si la page ouvre sur un hero plein écran : header transparent + texte adapté ('dark' = texte blanc, 'light' = encre). */
  heroTheme?: 'dark' | 'light';
  /** Chemins explicites FR/EN pour les pages dynamiques (canonical, hreflang, switch de langue). */
  altPaths?: { fr: string; en: string };
  /** JSON-LD additionnel (ex. FAQPage) — injecté en plus du schéma Organization. */
  jsonLd?: unknown;
}
const { title, description, pageId, locale, ogImage, heroTheme, altPaths, jsonLd } = Astro.props;

const c = getContent(locale);
const otherLocale: Locale = locale === 'fr' ? 'en' : 'fr';
const canonical = altPaths ? new URL(withBase(altPaths[locale]), Astro.site) : new URL(pathFor(pageId, locale), Astro.site);
const altFr = altPaths ? new URL(withBase(altPaths.fr), Astro.site) : new URL(pathFor(pageId, 'fr'), Astro.site);
const altEn = altPaths ? new URL(withBase(altPaths.en), Astro.site) : new URL(pathFor(pageId, 'en'), Astro.site);
const switchHref = altPaths ? withBase(altPaths[otherLocale]) : undefined;
const ogImagePath = ogImage ?? withBase('/brand/og.png');
const ogUrl = new URL(ogImagePath, Astro.site);

const homeUrl = new URL(withBase('/'), Astro.site).href;
const logoUrl = new URL(withBase('/brand/meridian-mark.png'), Astro.site).href;

// Google Search Console : colle ici le code « balise HTML » si tu choisis cette méthode.
// (Sinon, vérification recommandée par enregistrement DNS TXT chez Gandi — couvre tout le domaine.)
const GOOGLE_SITE_VERIFICATION = '';

// Google Analytics 4 : colle l'ID de mesure (ex. 'G-XXXXXXXXXX') pour activer.
// Laissé vide = aucun tag chargé. Consentement RGPD par défaut « refusé » (voir <head>).
const GA4_MEASUREMENT_ID = 'G-1TEFJJ6EXB';

// Profils publics — renforce la reconnaissance de l'entité par Google et les IA (GEO).
const SAME_AS: string[] = [
  // 'https://www.linkedin.com/company/VOTRE-PAGE',
  // 'https://github.com/VOTRE-COMPTE',
];

// Désambiguïsation d'entité (SEO + GEO) : on déclare explicitement le secteur LOGICIEL,
// pour ne pas être confondu avec un cabinet d'architecture du bâtiment.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: c.site.name,
  alternateName: 'Meridian — Architecture logicielle',
  url: homeUrl,
  logo: logoUrl,
  image: ogUrl.href,
  email: c.site.email,
  description: c.site.metaDescription,
  slogan: c.site.tagline,
  knowsAbout: [
    'Architecture logicielle',
    'Software architecture',
    'Écosystème logiciel sur-mesure',
    'Business Intelligence',
    'ERP',
    'PLM',
    'PIM',
    'Développement logiciel sur-mesure',
    'Intelligence artificielle',
  ],
  areaServed: 'FR',
  ...(SAME_AS.length ? { sameAs: SAME_AS } : {}),
};
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={altFr} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altFr} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={c.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="theme-color" content="#0e0e10" />
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    {GA4_MEASUREMENT_ID && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('consent', 'default', { ad_storage: 'denied', analytics_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
          gtag('js', new Date());
          gtag('config', '${GA4_MEASUREMENT_ID}');
        `} />
      </Fragment>
    )}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700&display=swap"
    />
  </head>
  <body>
    <a id="top"></a>
    <a class="skip-link" href="#main">{c.common.skip}</a>
    <Header locale={locale} pageId={pageId} heroTheme={heroTheme} switchHref={switchHref} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    {GA4_MEASUREMENT_ID && <ConsentBanner locale={locale} />}

    <script>
      // Masque proprement une image absente (emplacements photo à remplir)
      document.addEventListener(
        'error',
        (e) => {
          const t = e.target as HTMLElement | null;
          if (t && t.tagName === 'IMG') t.setAttribute('data-failed', 'true');
        },
        true
      );

      // Révélation au scroll (texte + images)
      const items = document.querySelectorAll('[data-reveal], [data-reveal-img]');
      if ('IntersectionObserver' in window && items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
