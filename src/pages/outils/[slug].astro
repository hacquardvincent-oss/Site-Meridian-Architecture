---
import Base from '../../layouts/Base.astro';
import ToolPage from '../../components/pages/ToolPage.astro';
import { getTools } from '../../i18n/tools';
import { withBase } from '../../i18n/routes';

const locale = 'fr' as const;

export function getStaticPaths() {
  return getTools('fr').map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props;
// Schéma i18n courant : FR à la racine, EN sous /en (cf. routes.ts).
// Ces chemins alimentent canonical + hreflang : toute erreur ici désindexe la page.
const altPaths = { fr: `/outils/${tool.slug}/`, en: `/en/tools/${tool.slug}/` };
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Fil d'Ariane : aide Google à situer la page dans l'arborescence, et les
// moteurs génératifs à comprendre qu'il s'agit d'une page de contexte.
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Réalisations', item: new URL(withBase('/outils/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: tool.name },
  ],
};

// Glossaire : termes définis explicitement, directement extractibles.
const termsLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: tool.name,
  hasDefinedTerm: tool.glossary.map((g) => ({
    '@type': 'DefinedTerm',
    name: g.term,
    description: g.def,
  })),
};
---
<Base title={tool.meta.title} description={tool.meta.description} pageId="outils" locale={locale} altPaths={altPaths} jsonLd={[faqLd, crumbLd, termsLd]}>
  <ToolPage locale={locale} tool={tool} />
</Base>
