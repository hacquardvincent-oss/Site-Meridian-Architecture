---
import Base from '../../layouts/Base.astro';
import SolutionsPage from '../../components/pages/SolutionsPage.astro';
import { getContent } from '../../i18n/content';

const locale = 'fr' as const;
const c = getContent(locale);
---
<Base title={c.solutions.meta.title} description={c.solutions.meta.description} pageId="solutions" locale={locale} heroTheme="light">
  <SolutionsPage locale={locale} />
</Base>
