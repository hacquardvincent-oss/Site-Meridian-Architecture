---
// L'anglais est désormais à la racine. On redirige l'ancienne adresse /en/ vers /.
import { withBase } from '../../i18n/routes';
const target = withBase('/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Meridian Architecture</title>
  </head>
  <body>
    <p>Redirecting to <a href={target}>Meridian Architecture</a>…</p>
  </body>
</html>
