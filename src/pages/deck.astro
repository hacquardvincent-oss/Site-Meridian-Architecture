---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ModuleGlyph from '../components/graphics/ModuleGlyph.astro';
import IsoStructure from '../components/graphics/IsoStructure.astro';
const modules = ['BI', 'ERP', 'PLM', 'PIM', 'WEB'];
const steps = [
  ['01', 'Cadrage', 'On cartographie votre métier et vos irritants.'],
  ['02', 'Conception', 'On architecture l’écosystème : modules, données, parcours.'],
  ['03', 'Build avec l’IA', 'On construit vite et juste.'],
  ['04', 'Intégration', 'On connecte vos outils existants.'],
  ['05', 'Évolution', 'L’écosystème vit et grandit avec vous.'],
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Présentation — Meridian Architecture</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&display=swap" />
  </head>
  <body class="deck-body">
    <div class="deck">
      <p class="hint">Template de présentation · <strong>Imprimer → PDF (paysage)</strong> ou présenter en plein écran. Non indexé.</p>

      <!-- 1 COVER -->
      <section class="slide slide--ink s-cover">
        <div class="s-top"><Logo /><span class="s-tag">Présentation</span></div>
        <svg class="s-geo" viewBox="0 0 600 400" aria-hidden="true" fill="none">
          <line x1="430" y1="20" x2="430" y2="380" stroke="#9db8dd" stroke-width="1.2" />
          <circle cx="430" cy="200" r="150" stroke="#fff" stroke-width="1" opacity="0.14" />
          <rect x="320" y="90" width="220" height="220" stroke="#fff" stroke-width="1" opacity="0.1" transform="rotate(7 430 200)" />
          <circle cx="430" cy="200" r="3.6" fill="#9db8dd" />
        </svg>
        <div class="s-cover__body">
          <span class="s-eyebrow">Architecture logicielle sur-mesure</span>
          <h1 class="s-cover__title">Un seul édifice <span class="i">pour tout votre métier.</span></h1>
          <p class="s-cover__sub">Nous remplaçons la multitude de logiciels rigides par un écosystème unique, sur-mesure et propulsé par l'IA.</p>
        </div>
        <div class="s-foot"><span>40.71°N 74.00°W</span><span>Meridian Architecture</span></div>
      </section>

      <!-- 2 DIVIDER -->
      <section class="slide slide--ink s-divider">
        <span class="s-num">01</span><hr class="s-rule" /><h2 class="s-divtitle">Le constat</h2>
      </section>

      <!-- 3 PROBLEME -->
      <section class="slide">
        <span class="s-eyebrow">Le constat</span>
        <h2 class="s-title">Vous n'avez pas un problème de logiciels.<br /><span class="muted">Vous en avez trop.</span></h2>
        <ul class="s-grid s-grid--4">
          <li><span class="s-k">Silos</span><p>Vos données vivent dans dix outils qui ne s'accordent jamais.</p></li>
          <li><span class="s-k">Rigidité</span><p>Vous pliez vos process pour entrer dans des cases génériques.</p></li>
          <li><span class="s-k">Ressaisies</span><p>La même information saisie trois fois, trois fois plus d'erreurs.</p></li>
          <li><span class="s-k">Facture</span><p>Des abonnements empilés, utilisés à moitié.</p></li>
        </ul>
      </section>

      <!-- 4 DIVIDER -->
      <section class="slide slide--ink s-divider">
        <span class="s-num">02</span><hr class="s-rule" /><h2 class="s-divtitle">La réponse</h2>
      </section>

      <!-- 5 VISION -->
      <section class="slide s-split">
        <div class="s-split__txt">
          <span class="s-eyebrow">La réponse Meridian</span>
          <h2 class="s-title">Le logiciel comme architecture.</h2>
          <ul class="s-ticks">
            <li>Sur-mesure : l'outil épouse votre métier.</li>
            <li>Interconnecté : une donnée saisie une fois, disponible partout.</li>
            <li>Propulsé par l'IA : conçu et construit vite, et juste.</li>
          </ul>
        </div>
        <div class="s-split__viz"><IsoStructure /></div>
      </section>

      <!-- 6 SOLUTIONS -->
      <section class="slide">
        <span class="s-eyebrow">Les domaines</span>
        <h2 class="s-title">Cinq domaines, un seul écosystème.</h2>
        <ul class="s-modules">
          {modules.map((m) => (
            <li><ModuleGlyph abbr={m} class="s-glyph" /><span class="s-k">{m}</span></li>
          ))}
        </ul>
      </section>

      <!-- 7 METHODE -->
      <section class="slide">
        <span class="s-eyebrow">La méthode</span>
        <h2 class="s-title">Un plan avant de bâtir.</h2>
        <ol class="s-steps">
          {steps.map((s) => (
            <li><span class="s-step-n">{s[0]}</span><span class="s-k">{s[1]}</span><p>{s[2]}</p></li>
          ))}
        </ol>
      </section>

      <!-- 8 DIVIDER -->
      <section class="slide slide--ink s-divider">
        <span class="s-num">03</span><hr class="s-rule" /><h2 class="s-divtitle">Travaillons ensemble</h2>
      </section>

      <!-- 9 CLOSING -->
      <section class="slide slide--ink s-closing">
        <div class="s-top"><Logo /><span class="s-tag">Contact</span></div>
        <div class="s-closing__body">
          <h2 class="s-cover__title">Décrivez votre métier. <span class="i">On vous montre l'édifice.</span></h2>
          <p class="s-cover__sub">Un premier échange suffit pour esquisser votre écosystème cible. Sans engagement.</p>
          <a class="s-mail" href="mailto:vincent@meridian-architecture.com">vincent@meridian-architecture.com</a>
        </div>
        <div class="s-foot"><span>meridian-architecture.com</span><span>Conçu sur-mesure</span></div>
      </section>
    </div>

    <style>
      .deck-body { background: #d7d6d2; }
      .deck { padding: 2.5rem 1rem; }
      .hint { max-width: 72rem; margin: 0 auto 1.5rem; font-size: 0.8rem; color: #555; text-align: center; }
      .slide {
        width: min(100%, 72rem); margin: 0 auto 1.5rem; aspect-ratio: 16 / 9; background: var(--plaster);
        color: var(--ink); position: relative; overflow: hidden; box-shadow: 0 14px 40px -18px rgba(0,0,0,0.4);
        display: flex; flex-direction: column; padding: clamp(1.5rem, 4vw, 3.5rem);
      }
      .slide--ink { background: var(--ink); color: #fff; }
      .slide--ink .s-title, .slide--ink h2 { color: #fff; }

      .s-eyebrow { display: inline-flex; align-items: center; gap: 0.7rem; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-subtle); }
      .slide--ink .s-eyebrow { color: var(--accent); }
      .s-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.6rem, 3.6vw, 2.8rem); line-height: 1.05; letter-spacing: -0.02em; margin-top: 1rem; max-width: 24ch; }

      /* cover */
      .s-top { display: flex; justify-content: space-between; align-items: center; color: #fff; }
      .s-tag { font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(255,255,255,0.6); }
      .s-geo { position: absolute; inset: 0; width: 100%; height: 100%; }
      .s-cover__body { margin-top: auto; position: relative; z-index: 2; }
      .s-cover__title { font-family: var(--font-display); font-weight: 400; font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.0; letter-spacing: -0.025em; color: #fff; }
      .s-cover__title .i { font-style: italic; font-weight: 300; }
      .s-cover__sub { font-size: clamp(0.95rem, 1.6vw, 1.15rem); color: rgba(255,255,255,0.8); margin-top: 1rem; max-width: 46ch; }
      .s-foot { display: flex; justify-content: space-between; margin-top: auto; position: relative; z-index: 2; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
      .s-cover .s-cover__body { margin-top: auto; }

      /* divider */
      .s-divider { justify-content: center; }
      .s-num { font-family: var(--font-display); font-size: clamp(2.5rem, 7vw, 5rem); font-weight: 300; color: rgba(255,255,255,0.25); line-height: 1; }
      .s-rule { width: 4rem; height: 1px; border: 0; background: linear-gradient(90deg, var(--accent), transparent); margin: 1.2rem 0; }
      .s-divtitle { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.8rem, 4.5vw, 3rem); font-style: italic; color: #fff; }

      /* grids */
      .s-grid { list-style: none; padding: 0; margin: auto 0 0; display: grid; gap: 1.2rem; }
      .s-grid--4 { grid-template-columns: repeat(4, 1fr); }
      .s-grid li { border-top: 1px solid var(--line-strong); padding-top: 0.8rem; }
      .s-k { font-family: var(--font-display); font-weight: 500; font-size: 1.05rem; }
      .s-grid p, .s-modules p, .s-steps p { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.35rem; }

      .s-split { display: grid; }
      .s-split { grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: center; }
      .s-split__viz { max-width: 16rem; margin-inline: auto; }
      .s-ticks { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: 0.6rem; }
      .s-ticks li { position: relative; padding-left: 1.4rem; color: var(--text-muted); }
      .s-ticks li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 0.9rem; height: 1px; background: var(--ink); }

      .s-modules { list-style: none; padding: 0; margin: auto 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.2rem; }
      .s-modules li { display: flex; flex-direction: column; gap: 0.5rem; border-top: 1px solid var(--line-strong); padding-top: 1rem; }
      .s-glyph { width: 2.5rem; height: 2.5rem; color: var(--ink); }

      .s-steps { list-style: none; padding: 0; margin: auto 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; }
      .s-steps li { border-top: 1px solid var(--line-strong); padding-top: 0.8rem; }
      .s-step-n { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-deep); display: block; margin-bottom: 0.4rem; }

      .s-closing__body { margin-top: auto; position: relative; z-index: 2; }
      .s-mail { display: inline-block; margin-top: 1.4rem; font-family: var(--font-display); font-size: clamp(1.1rem, 2.4vw, 1.6rem); color: #fff; border-bottom: 1px solid var(--accent); padding-bottom: 3px; }

      @media print {
        @page { size: A4 landscape; margin: 0; }
        .deck-body { background: #fff; }
        .deck { padding: 0; }
        .hint { display: none; }
        .slide { width: 100%; max-width: none; height: 100vh; aspect-ratio: auto; margin: 0; box-shadow: none; page-break-after: always; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      }
      @media (max-width: 40em) {
        .s-grid--4, .s-modules, .s-steps { grid-template-columns: repeat(2, 1fr); }
        .s-split { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
